# Copier en .env (non versionné) et remplir
LDR_USER=youn
LDR_PASSWORD=change-moi

# Synchro Stripe (optionnel) : clé restreinte en lecture seule, droit « Charges : lecture »
# LDR_STRIPE_KEY=rk_live_...
# LDR_STRIPE_INTERVAL=60          # minutes entre deux synchros
# LDR_STRIPE_SINCE=2026-01-01     # ignorer les paiements avant cette date
